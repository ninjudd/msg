{
  "name": "msg",
  "version": "0.1.0",
  "description": "Read and send iMessages from the command line",
  "type": "module",
  "bin": {
    "msg": "./dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:msgd": "node scripts/build-msgd.mjs",
    "prepare": "pnpm build",
    "msg": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "postject": "1.0.0-alpha.6",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
